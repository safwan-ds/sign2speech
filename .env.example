# Sign2Speech remote LLM configuration
# Copy this file to .env and fill in your values

# Backend: "local" (QWEN llama.cpp) or "remote" (HTTP API)
LLM_BACKEND=local

# Remote API settings
# Nous API: https://inference-api.nousresearch.com/v1 with format=chat
# OpenRouter: https://openrouter.ai/api/v1/chat/completions with format=chat
LLM_REMOTE_URL=https://inference-api.nousresearch.com/v1
LLM_REMOTE_API_KEY=your-a...e
# API format: "chat" (OpenAI-compatible /v1/chat/completions) or "completions" (legacy /v1/completions)
LLM_REMOTE_FORMAT=chat
# StepFun reasoning models need higher token limits; 512 is a safe default
LLM_REMOTE_MAX_TOKENS=512
